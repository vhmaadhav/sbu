# Runtime
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8010
LOG_LEVEL=INFO
# Use "json" in production and "console" for readable local logs.
LOG_FORMAT=console
# Browser origins only; native mobile clients are not subject to CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production must use explicit public/internal hostnames instead of *.
TRUSTED_HOSTS=*
FORWARDED_ALLOW_IPS=127.0.0.1
MAX_UPLOAD_MB=1000
AXIOM_TRACE_MENUBAR=true
AXIOM_TRACE_TELEGRAM=true

# Chat endpoint. Any OpenAI-compatible server: a local LM Studio, or a hosted
# gateway. VISION_MODEL must be a model that accepts image input — several
# text-only models answer an image request with a bare 400.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen3.5-4b-mlx
VISION_MODEL=qwen/qwen3-vl-4b

# Sent as reasoning_effort on every chat call. Reasoning models can otherwise
# spend the entire max_tokens budget thinking and return empty content. Set to
# an empty value to send the field at all; endpoints that reject it are also
# detected once at runtime and skipped from then on.
LLM_REASONING_EFFORT=low

# Diagram understanding (all local)
DIAGRAM_OCR_MODEL=paddleocr-vl-1.6
DIAGRAM_VISION_MODEL=qwen/qwen3-vl-4b
DIAGRAM_VALIDATOR_MODEL=qwen3.5-4b-mlx
# Optional fine-tuned D-FINE/RT-DETRv2 checkpoint adapter. When omitted, the
# pipeline reports the detector stage as unavailable and never fakes results.
DIAGRAM_DETECTOR_WEIGHTS=
VISION_MODEL=qwen/qwen3-vl-4b

# Models (all local, lightweight)
# Cross-encoder reranking: retrieve 24 vector candidates, then keep the API's requested k.
RERANKER_ENABLED=true
RERANKER_MODEL=mlx-community/Qwen3-Reranker-0.6B-mxfp8
RERANKER_CANDIDATE_K=24
RERANKER_MAX_CHARS=6000
STT_MODEL=moonshine/base
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
KOKORO_VOICE=af_heart

# Paths (relative to backend/ by default)
DATA_DIR=data
INBOX_DIR=inbox

# Google Calendar (OAuth 2.0; use a local .env and never commit the secret)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8010/api/calendar/google/callback
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
WEB_BASE_URL=http://localhost:3000

# Telegram bot (create/rotate with @BotFather; never commit the token)
TELEGRAM_BOT_TOKEN=
# Send /id to the bot, then add your numeric Telegram user ID here.
TELEGRAM_ALLOWED_USER_IDS=
# Optional: additionally restrict allowed chat IDs (comma-separated).
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOW_ALL=false
TELEGRAM_MAX_UPLOAD_MB=20
