# Copy to .env.docker, then run:
# docker compose --env-file .env.docker up --build -d

# Published ports
WEB_PUBLISHED_PORT=3000
BACKEND_PUBLISHED_PORT=8010

# LM Studio on the same laptop as Docker:
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen3.5-4b-mlx
VISION_MODEL=qwen/qwen3-vl-4b

# If Docker runs on a remote server, replace LMSTUDIO_BASE_URL with a laptop
# LAN/VPN address reachable from that server, for example:
# LMSTUDIO_BASE_URL=http://100.64.0.10:1234/v1

APP_ENV=development
LOG_FORMAT=console
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=*
FORWARDED_ALLOW_IPS=127.0.0.1

STUDY_BUDDY_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOW_ALL=false

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8010/api/calendar/google/callback
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
WEB_BASE_URL=http://localhost:3000

# Initial backend URL embedded in the debug Android APK.
ANDROID_API_URL=http://10.0.2.2:8010

# Study pet (macOS desktop pet; runs natively, not in Docker)
PET_POLL_SECONDS=5
PET_NOTICE_SECONDS=90
PET_CONCERNED_SECONDS=180
PET_NAG_SECONDS=360
PET_PLEAD_SECONDS=600
PET_RECOVERY_SECONDS=60
PET_BUBBLE_COOLDOWN=90
PET_PLEAD_REPEAT_SECONDS=240
PET_BACKEND_URL=http://127.0.0.1:8010
# Comma-separated overrides, e.g. PET_STUDY_APPS=Figma,Blender
PET_STUDY_APPS=
PET_DISTRACT_HOSTS=
